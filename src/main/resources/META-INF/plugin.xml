<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.github.ivarref.pluggy</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Pluggy</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/ivarref/">github.com/ivarref</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description>Min plugin. Den er kjempebra! Og må tydelegvis innehalda minst 40 teikn.
    </description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.vcs</depends>
<!--    <depends>com.intellij.modules.lsp</depends>-->

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
<!--    <extensions defaultExtensionNs="com.intellij">-->
<!--        <projectService serviceImplementation="com.github.ivarref.ideafinda.LspClientService"/>-->
<!--    </extensions>-->
    <actions>
        <group id="com.github.ivarref.ChooseInitialNextAction"
               text="Devil Mode - Choose Initial Next Action"
               popup="true">
            <add-to-group
                    group-id="ToolsMenu"
                    anchor="after"
                    relative-to-action="com.github.ivarref.ideafinda.PopupDialogAction"/>
            <action
                    class="com.github.ivarref.ideafinda.NextErrorAction"
                    id="org.intellij.sdk.action.GroupPopDialogAction1"
                    text="&amp;error"
                    description="Go to next error">
            </action>
            <action
                    class="com.github.ivarref.ideafinda.NextChangeAction"
                    id="org.intellij.sdk.action.GroupPopDialogAction2"
                    text="&amp;change"
                    description="Go to next change">
            </action>
        </group>
        <action
                class="com.github.ivarref.ideafinda.NextChangeAction"
                id="com.github.ivarref.ideafinda.NextChangeAction"
                text="Go to next change (with wrap around)"
                description="Go to next change">
        </action>
        <action
                class="com.github.ivarref.ideafinda.PrevChangeAction"
                id="com.github.ivarref.ideafinda.PrevChangeAction"
                text="Go to previous change (with wrap around)"
                description="Go to previous change">
        </action>

        <action
                class="com.github.ivarref.ideafinda.MoveToNextTabGroup"
                id="com.github.ivarref.ideafinda.MoveToNextTabGroup"
                text="Move to next tab group, creating group if needed (max two splits)">
        </action>

        <action
                class="com.github.ivarref.ideafinda.CopyToNextTabGroup"
                id="com.github.ivarref.ideafinda.CopyToNextTabGroup"
                text="Copy to next tab group, creating group if needed (max two splits)">
        </action>

        <action id="com.github.ivarref.ideafinda.NextWhateverAction"
                class="com.github.ivarref.ideafinda.NextWhateverAction" text="Next Whatever Action"
                description="Next whatever action">
        </action>
        <action id="com.github.ivarref.ideafinda.PrevWhateverAction"
                class="com.github.ivarref.ideafinda.PrevWhateverAction"
                text="Previous Whatever Action"
                description="Previous whatever action">
<!--            <keyboard-shortcut keymap="$default" first-keystroke="meta P"/>-->
        </action>
<!--        <action id="com.github.ivarref.ideafinda.WindowChooseAction"-->
<!--                class="com.github.ivarref.ideafinda.WindowChooseAction" text="Choose Window Action">-->
<!--            <keyboard-shortcut keymap="$default" first-keystroke="COMMA" second-keystroke="W"/>-->
<!--        </action>-->
